<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- 1. Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.rinconsur.probadores.ui.auth.LoginFragment"
        android:label="Iniciar Sesión"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <action
            android:id="@+id/action_loginFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
        <action
            android:id="@+id/action_loginFragment_to_AdminFragment"
            app:destination="@id/AdminFragment" />

    </fragment>

    <!-- 2. Cliente (FirstFragment) -->
    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.rinconsur.probadores.ui.cliente.FirstFragment"
        android:label="Vista Cliente"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

    </fragment>

    <!-- 3. Asistente (SecondFragment) -->
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.rinconsur.probadores.ui.asistente.SecondFragment"
        android:label="Panel Operativo · Asistente"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

    </fragment>

    <!-- 4. Administrador (AdminFragment) -->
    <fragment
        android:id="@+id/AdminFragment"
        android:name="com.rinconsur.probadores.ui.admin.AdminFragment"
        android:label="Panel de Administración"
        tools:layout="@layout/fragment_admin">

        <action
            android:id="@+id/action_AdminFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

    </fragment>

</navigation>